# Public URLs (only NEXT_PUBLIC_* values are exposed to the browser)
APP_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# PostgreSQL
POSTGRES_DB=vietnam_car_platform
POSTGRES_USER=vcp
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=Host=postgres;Port=5432;Database=vietnam_car_platform;Username=vcp;Password=change-me-local-only

# Redis
REDIS_URL=redis:6379

# S3-compatible object storage (MinIO locally, R2/S3 in production)
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_HEALTH_ENDPOINT=http://minio:9000/minio/health/live
OBJECT_STORAGE_BUCKET=vcp-snapshots
OBJECT_STORAGE_ACCESS_KEY=vcp-local
OBJECT_STORAGE_SECRET_KEY=change-me-local-only
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_FORCE_PATH_STYLE=true

# External discovery/integrations — server/worker only
BRAVE_SEARCH_API_KEY=
BRAVE_MONTHLY_REQUEST_BUDGET=1000
BRAVE_DISCOVERY_CACHE_SECONDS=86400
BRAVE_DISCOVERY_MAX_QUERIES=4
GOONG_API_KEY=
GOONG_MAPTILES_KEY=
OPEN_CHARGE_MAP_API_KEY=

# Observability
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Ingestion
INGESTION_USER_AGENT=VietnamCarPlatformBot/0.1 (+https://example.invalid/data-policy)
INGESTION_MAX_CONCURRENCY=4
INGESTION_QUEUE=ingestion:jobs
INGESTION_SCHEDULE_SECONDS=60

# Admin bootstrap — local/initial use only; rotate or remove after provisioning
ADMIN_BOOTSTRAP_EMAIL=admin@example.invalid
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-random-password-at-least-14-characters
