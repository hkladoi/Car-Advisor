{
  "name": "vietnam-car-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/contracts",
    "packages/taxonomy"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @vcp/web",
    "build:web": "npm run build --workspace @vcp/web",
    "lint:web": "npm run lint --workspace @vcp/web",
    "test:web": "npm run test --workspace @vcp/web",
    "generate:api-client": "npm run generate:api --workspace @vcp/web",
    "check": "npm run lint:web && npm run test:web && npm run build:web"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  }
}

